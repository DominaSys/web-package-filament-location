{
    "name": "dominasys/filament-location",
    "description": "Filament package for address and location handling with smart lookup and dynamic selects",
    "keywords": [
        "dominasys",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-location"
    ],
    "homepage": "https://github.com/dominasys/web-package-filament-location",
    "support": {
        "issues": "https://github.com/dominasys/web-package-filament-location/issues",
        "source": "https://github.com/dominasys/web-package-filament-location"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Bruno Mangilli",
            "email": "nobrudevz@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0",
        "rector/rector": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "Dominasys\\FilamentLocation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dominasys\\FilamentLocation\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "test": "pest",
        "test:lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dominasys\\FilamentLocation\\FilamentLocationServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
